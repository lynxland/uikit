{
  "name": "@lynxland/uikit-ui-shadcn",
  "version": "3.0.0",
  "description": "Default Base UI + shadcn UI adapter for @lynxland/uikit v3 — primitives and semantic tokens",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynxland/uikit.git",
    "directory": "packages/ui-shadcn"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "catalog:default",
    "@lynxland/uikit-surfaces": "workspace:*",
    "class-variance-authority": "catalog:default",
    "clsx": "catalog:default",
    "lucide-react": "catalog:default",
    "tailwind-merge": "catalog:default"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "jsdom": "^28.0.0",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
