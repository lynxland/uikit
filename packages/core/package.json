{
  "name": "@lynxland/uikit-core",
  "version": "3.0.0",
  "description": "Headless v3 contracts, schema, and adapters for @lynxland/uikit — zero React, zero Effect",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynxland/uikit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kernel": {
      "types": "./src/kernel/index.ts",
      "default": "./src/kernel/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
