{
  "name": "@lynxland/uikit-testing",
  "version": "3.0.0",
  "description": "v3 test harness for @lynxland/uikit — renderWithKit / createTestRouter / source-command-stream mocks",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynxland/uikit.git",
    "directory": "packages/testing"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lynxland/uikit-core": "workspace:*",
    "@lynxland/uikit-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@testing-library/react": ">=16",
    "@tanstack/react-query": ">=5.100",
    "@tanstack/react-router": ">=1.120"
  },
  "devDependencies": {
    "@tanstack/react-form": "catalog:default",
    "@tanstack/react-query": "catalog:default",
    "@tanstack/react-router": "catalog:default",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "jsdom": "^28.0.0",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
