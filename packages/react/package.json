{
  "name": "@lynxland/uikit-react",
  "version": "3.0.0",
  "description": "v3 React bindings for @lynxland/uikit-core — collection/record/lookup/command/stream + optional router URL bindings",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynxland/uikit.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lynxland/uikit-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "@tanstack/react-query": ">=5.100",
    "@tanstack/react-router": ">=1.120",
    "@tanstack/react-form": ">=1.30"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-form": "catalog:default",
    "@tanstack/react-query": "catalog:default",
    "@tanstack/react-router": "catalog:default",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:default",
    "@types/react-dom": "catalog:default",
    "jsdom": "^28.0.0",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  }
}
